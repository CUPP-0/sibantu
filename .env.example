DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
DATABASE_SSL=true

APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
DATA_LOOKUP_SECRET=use-a-different-random-secret-for-lookup-hashes
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Optional: path to the Supabase database CA PEM if Node does not trust its certificate.
# DATABASE_SSL_CA=./certs/supabase-root-ca.crt
